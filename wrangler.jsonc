{
  "name": "sarasfinance-status",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
